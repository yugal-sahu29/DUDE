# Groq API Credentials (Get your free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Model Selection (qwen/qwen3.8-27b or openai/gpt-oss-20b)
GROQ_MODEL=qwen/qwen3.8-27b

# Temperature setting (0.0 to 2.0)
GROQ_TEMPERATURE=0.7

# Max tokens per response
GROQ_MAX_TOKENS=800

# Voice Output & Input (Level 4: Multimodal)
# Set to true to speak DUDE's responses automatically (or toggle in terminal via /voice on)
DUDE_VOICE_ENABLED=false
DUDE_VOICE_SPEAKER=en-US-GuyNeural
DUDE_VOICE_RATE=+0%
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Standalone Server & App Configuration (Independent App)
DUDE_HOST=0.0.0.0
DUDE_PORT=8000
